  - name: Setup Node.js
    uses: actions/setup-node@v4
    with:
      node-version: '20'

  # Step 1: Install PDF Generation Tool (e.g., Puppeteer)
  # This step represents installing the necessary tools to generate the PDF 
  # based on a custom HTML template.
  - name: Install Dependencies
    run: npm install puppeteer

  # Step 2: Generate PDF using dynamic and static content
  # This is the conceptual core step that addresses all user requirements.
  - name: Create and Generate PDF
    id: pdf_generator
    run: |
      # The input JSON payload from the HTML form (via repository_dispatch)
      PAYLOAD='${{ github.event.inputs.client_payload }}'
      
      # Static Content (Pre-written text not on the calculator page)
      STATIC_INTRO="## Why Language Training is Key to Global Success"
      STATIC_BODY="Global expansion and effective international collaboration hinge on strong communication. Investing in dedicated language training platforms like Speexx minimizes operational risk from miscommunication, boosts employee confidence, and accelerates global market penetration. This report summarizes your custom scenario and the potential ROI for your organization."

      # SVG Logo (XML is base64 encoded to easily pass through environment vars/scripts)
      # Note: The SVG is scaled to 104.22px x 22.5px in the final PDF template.
      SVG_LOGO_BASE64=""
      
      # HTML Template that combines static and dynamic data
      # It includes placeholders like {{ROI_PERCENTAGE}}, {{STATIC_INTRO}}, etc.
      # The logo is placed using absolute positioning in the header.
      REPORT_TEMPLATE="<!DOCTYPE html>
      <html>
        <head>
          <meta charset='UTF-8'>
          <title>ROI Report</title>
          <style>
            body { font-family: Arial, sans-serif; margin: 0; padding: 0; }
            .report-header { 
                position: relative; 
                height: 90px; 
                border-bottom: 2px solid #FF7900; 
                padding: 0 57px; 
                margin-bottom: 30px;
            }
            .logo { 
                position: absolute; 
                top: 32px; /* Y: 32px from top margin (72px) - 40px offset = 32px */
                left: 57px; 
                width: 104.22px; 
                height: 22.5px;
            }
            .content { padding: 0 57px; }
            h1 { color: #FF7900; font-size: 24px; }
            h2 { border-bottom: 1px solid #ccc; padding-bottom: 5px; margin-top: 30px; }
            .result-box { border: 1px solid #FF7900; padding: 20px; border-radius: 8px; margin-top: 20px; }
            .key-value { margin-bottom: 10px; }
            .key-value strong { display: inline-block; width: 180px; color: #555; }
          </style>
        </head>
        <body>
          <div class='report-header'>
            <!-- SVG Logo placed at X: 57px, Y: 32px relative to top of report area -->
            <img class='logo' src='data:image/svg+xml;base64,${SVG_LOGO_BASE64}' alt='Speexx Logo'/>
          </div>

          <div class='content'>
            <h1>ROI Calculation Report: {{ROI_PERCENTAGE}}</h1>
            
            <!-- STATIC CONTENT -->
            <h2>{{STATIC_INTRO}}</h2>
            <p>{{STATIC_BODY}}</p>

            <!-- DYNAMIC CONTENT: RESULTS -->
            <h2>Your Scenario Results</h2>
            <div class='result-box'>
              <div class='key-value'><strong>ROI Percentage:</strong> {{ROI_PERCENTAGE}}</div>
              <div class='key-value'><strong>Annual Benefit:</strong> {{ANNUAL_BENEFIT}}</div>
              <div class='key-value'><strong>Total Investment:</strong> {{TOTAL_INVESTMENT}}</div>
              <div class='key-value'><strong>Return Per €1:</strong> {{RETURN_PER_EURO}}</div>
              <div class='key-value'><strong>Confidence Level:</strong> {{CONFIDENCE_LEVEL}}</div>
              <p style='margin-top: 15px; font-style: italic;'>{{TAGLINE}}</p>
            </div>
            
            <!-- DYNAMIC CONTENT: INPUTS -->
            <h2>Input Parameters</h2>
            <div class='key-value'><strong>Region:</strong> {{REGION}}</div>
            <div class='key-value'><strong>Company Size:</strong> {{COMPANY_SIZE}}</div>
            <div class='key-value'><strong>Industry:</strong> {{INDUSTRY}}</div>
            <div class='key-value'><strong>Learners:</strong> {{LEARNERS}}</div>
            <div class='key-value'><strong>Programme Intensity:</strong> {{INTENSITY}}</div>
            <div class='key-value'><strong>Cost Per Learner:</strong> {{COST_PER_LEARNER}}</div>
            <div class='key-value'><strong>Time Horizon:</strong> {{TIME_HORIZON}}</div>
            <div class='key-value'><strong>Languages:</strong> {{LANGUAGES}}</div>
            <div class='key-value'><strong>Impact Areas:</strong> {{IMPACT_AREAS}}</div>
          </div>
        </body>
      </html>"

      # Use Node.js to process the payload and generate the PDF
      cat <<EOF > generate_pdf.js
      const puppeteer = require('puppeteer');
      const fs = require('fs');

      const payload = JSON.parse(fs.readFileSync('payload.json', 'utf8'));

      // Extract dynamic data from payload
      const results = payload.results || {};
      const inputs = payload.inputs || {};

      // Use the template and replace placeholders with dynamic/static content
      let html = \`${REPORT_TEMPLATE}\`;
      
      // Replace dynamic results
      html = html.replace('{{ROI_PERCENTAGE}}', results.roiPercentage || 'N/A');
      html = html.replace('{{ANNUAL_BENEFIT}}', results.annualBenefit || 'N/A');
      html = html.replace('{{TOTAL_INVESTMENT}}', results.totalInvestment || 'N/A');
      html = html.replace('{{RETURN_PER_EURO}}', results.returnPerEuro || 'N/A');
      html = html.replace('{{CONFIDENCE_LEVEL}}', results.confidenceLevel || 'N/A');
      html = html.replace('{{TAGLINE}}', results.tagline || '');

      // Replace dynamic inputs
      html = html.replace('{{REGION}}', inputs.region || 'N/A');
      html = html.replace('{{COMPANY_SIZE}}', inputs.companySize || 'N/A');
      html = html.replace('{{INDUSTRY}}', inputs.industry || 'N/A');
      html = html.replace('{{LEARNERS}}', inputs.learners || 'N/A');
      html = html.replace('{{INTENSITY}}', inputs.intensity || 'N/A');
      html = html.replace('{{COST_PER_LEARNER}}', inputs.costPerLearner || 'N/A');
      html = html.replace('{{TIME_HORIZON}}', inputs.horizon || 'N/A');
      html = html.replace('{{LANGUAGES}}', (inputs.languages || []).join(', ') || 'N/A');
      html = html.replace('{{IMPACT_AREAS}}', (inputs.impactAreas || []).join(', ') || 'N/A');

      // Replace static content
      html = html.replace('{{STATIC_INTRO}}', \`${STATIC_INTRO}\`);
      html = html.replace('{{STATIC_BODY}}', \`${STATIC_BODY}\`);


      async function generatePdf() {
        // Launch the browser
        const browser = await puppeteer.launch({ 
            headless: true,
            args: ['--no-sandbox', '--disable-setuid-sandbox'] 
        });
        const page = await browser.newPage();
        
        // Set content and wait for it to load
        await page.setContent(html, { waitUntil: 'networkidle0' });

        // Generate PDF with required margins and footer/header setup
        await page.pdf({
          path: 'roi_report.pdf',
          format: 'A4',
          printBackground: true,
          margin: {
            top: '72px',    /* 72px Top Margin */
            right: '57px',  /* 57px Right Margin */
            bottom: '57px', /* 57px Bottom Margin */
            left: '57px'    /* 57px Left Margin */
          },
          displayHeaderFooter: true,
          footerTemplate: '<div style="font-size: 8px; margin-left: 57px; width: 100%; text-align: left;">Report Generated on ' + new Date().toLocaleDateString() + ' | Page <span class="pageNumber"></span> of <span class="totalPages"></span></div>',
          headerTemplate: '<div style="height: 0;"></div>' // Empty header, logo is in body content
        });

        await browser.close();
        console.log('PDF generated successfully as roi_report.pdf');
      }

      generatePdf().catch(err => {
        console.error('PDF Generation Error:', err);
        process.exit(1);
      });
      EOF

      # Create the payload file
      echo "$PAYLOAD" > payload.json
      
      # Run the PDF generation script
      node generate_pdf.js

  # Step 3: Upload the generated PDF as an artifact
  - name: Upload PDF Artifact
    uses: actions/upload-artifact@v4
    with:
      name: roi-full-report
      path: roi_report.pdf
      retention-days: 5
